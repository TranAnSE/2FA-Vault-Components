{
    "name": "@2fauth/ui",
    "type": "module",
    "version": "0.2.0",
    "scripts": {
        "build": "vite build",
        "build:types": "node -e \"require('node:fs').rmSync('dist/types',{recursive:true,force:true})\" && vue-tsc -p tsconfig.types.json",
        "watch": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
        "prepack": "pnpm run build && pnpm run build:types"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "types": "./dist/types/index.d.ts"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "dependencies": {
        "@2fauth/formcontrols": "link:..\\formcontrols"
    },
    "devDependencies": {
        "@histoire/plugin-vue": "1.0.0-beta.1",
        "@kyvg/vue3-notification": "^3.4.2",
        "@lucide/vue": "^1.17.0",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^25.2.3",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/tsconfig": "^0.8.1",
        "@vueuse/components": "^14.3.0",
        "@vueuse/core": "^14.3.0",
        "jsdom": "^30.0.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "vue": "^3.5.28",
        "vue-tsc": "^3.2.4"
    },
    "peerDependencies": {
        "@2fauth/formcontrols": "workspace:*",
        "@kyvg/vue3-notification": "^3.4.2",
        "@lucide/vue": "^1.17.0",
        "@vueuse/components": "^14.3.0",
        "@vueuse/core": "^14.3.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.4.4"
    }
}