{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist/types",
        "noEmit": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.vue"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.js",
        "src/**/*.story.vue",
        "dist",
        "node_modules"
    ]
}
