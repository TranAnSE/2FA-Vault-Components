{
    "name": "@2fauth/stores",
    "type": "module",
    "version": "0.1.0",
    "scripts": {
        "build": "vite build",
        "build:types": "node -e \"require('node:fs').rmSync('dist/types',{recursive:true,force:true})\" && vue-tsc -p tsconfig.types.json",
        "watch": "vite build --watch",
        "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
        "prepack": "pnpm run build && pnpm run build:types"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "types": "./dist/types/index.d.ts"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "devDependencies": {
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^25.2.3",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/tsconfig": "^0.8.1",
        "jsdom": "^28.0.0",
        "pinia": "^3.0.4",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "vue": "^3.5.28",
        "vue-tsc": "^3.2.4"
    },
    "peerDependencies": {
        "pinia": "^3.0.2",
        "vue": "^3.5.13"
    }
}